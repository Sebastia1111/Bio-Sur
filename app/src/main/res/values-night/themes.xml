<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base BIOSUR para Modo Oscuro -->
    <style name="Theme.BIOSUR" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryVariant">@color/blue_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_pale</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/orange_primary</item>
        <item name="colorSecondaryVariant">@color/orange_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/orange_pale</item>
        <item name="colorOnSecondaryContainer">@color/orange_light</item>

        <item name="android:colorBackground">@color/bg_app</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/blue_pale</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorOutline">@color/outline</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:statusBarColor">@color/blue_deep</item>
        <item name="android:navigationBarColor">@color/blue_deep</item>

        <item name="materialCardViewStyle">@style/Widget.BIOSUR.CardView</item>
        <item name="textInputStyle">@style/Widget.BIOSUR.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.BIOSUR.BottomNavigationView</item>
    </style>
</resources>
