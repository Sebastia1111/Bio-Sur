<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base BIOSUR (Material 3) -->
    <style name="Theme.BIOSUR" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Paleta primaria (azul) -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryVariant">@color/blue_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_pale</item>
        <item name="colorOnPrimaryContainer">@color/blue_deep</item>

        <!-- Secundario (naranjo) -->
        <item name="colorSecondary">@color/orange_primary</item>
        <item name="colorSecondaryVariant">@color/orange_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/orange_pale</item>
        <item name="colorOnSecondaryContainer">@color/orange_dark</item>

        <!-- Backgrounds -->
        <item name="android:colorBackground">@color/bg_app</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/blue_pale</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/blue_deep</item>
        <item name="android:navigationBarColor">@color/blue_deep</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Tipografía -->
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.BIOSUR.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.BIOSUR.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.BIOSUR.Body</item>

        <!-- Componentes -->
        <item name="materialCardViewStyle">@style/Widget.BIOSUR.CardView</item>
        <item name="textInputStyle">@style/Widget.BIOSUR.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.BIOSUR.BottomNavigationView</item>
    </style>

    <!-- Splash (pantalla de inicio azul con logo) -->
    <style name="Theme.BIOSUR.Splash" parent="Theme.BIOSUR">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
    </style>

    <!-- Tipografías -->
    <style name="TextAppearance.BIOSUR.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/blue_deep</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.BIOSUR.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.BIOSUR.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- CardView estilo BIOSUR -->
    <style name="Widget.BIOSUR.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider</item>
    </style>

    <!-- TextInputLayout estilo BIOSUR -->
    <style name="Widget.BIOSUR.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/blue_primary</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="hintTextColor">@color/blue_primary</item>
    </style>

    <!-- Botones -->
    <style name="Widget.BIOSUR.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/blue_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.BIOSUR.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/blue_primary</item>
        <item name="android:textColor">@color/blue_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.BIOSUR.Button.Accent" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/orange_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- BottomNavigationView -->
    <style name="Widget.BIOSUR.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.BIOSUR.BottomNavigationView.ItemActiveIndicator</item>
        <item name="itemIconTint">@color/blue_primary</item>
        <item name="itemTextColor">@color/blue_primary</item>
        <item name="backgroundTint">@color/white</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.BIOSUR.BottomNavigationView.ItemActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/blue_pale</item>
    </style>
</resources>
